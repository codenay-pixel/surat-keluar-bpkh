# Salin file ini jadi ".env.local" lalu isi nilainya masing-masing.
# JANGAN PERNAH commit file ".env.local" (sudah otomatis diabaikan lewat .gitignore).

# Project Settings > API di dashboard Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings > API > "service_role" secret key (BUKAN "anon" key!)
# Kunci ini punya akses penuh ke database - jangan pernah dikirim ke browser
# atau ditaruh di kode yang bisa dilihat publik.
SUPABASE_SERVICE_ROLE_KEY=

# String acak apa saja, minimal 32 karakter, untuk menandatangani sesi
# login. Buat sekali di awal lalu JANGAN diubah-ubah (mengubahnya akan
# otomatis melogout semua admin). Contoh membuatnya lewat terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
